## Check how reference types in function signatures are read. The module has
## a single type:
##   (func (param (ref null extern) (ref func) (ref null exn) (ref any)
##                (ref null 0))
##         (result (ref exn) externref))
# RUN: echo -e -n "\x00asm\x01\x00\x00\x00\x01\x11\x01\x60\x05\x63\x6f\x64\x70\x63\x69\x64\x6e\x63\x00\x02\x64\x69\x6f" > %t.wasm
# RUN: obj2yaml %t.wasm | FileCheck %s

## (ref null ht) is the same type as the htref shorthand. References to heap
## types other than func, extern and exn are not modeled.
#      CHECK:  - Type:            TYPE
# CHECK-NEXT:    Signatures:
# CHECK-NEXT:      - Index:           0
# CHECK-NEXT:        ParamTypes:
# CHECK-NEXT:          - EXTERNREF
# CHECK-NEXT:          - REF_FUNC
# CHECK-NEXT:          - EXNREF
# CHECK-NEXT:          - OTHERREF
# CHECK-NEXT:          - OTHERREF
# CHECK-NEXT:        ReturnTypes:
# CHECK-NEXT:          - REF_EXN
# CHECK-NEXT:          - EXTERNREF

## Tables, globals, element segments and locals only model nullable
## references. The module is:
##   (type (func))
##   (import "e" "t" (table 0 (ref null func)))
##   (import "e" "g" (global (ref null extern)))
##   (import "e" "h" (global (ref extern)))
##   (table 0 (ref null extern))
##   (global (ref null extern) (ref.null extern))
##   (elem (ref null func))
##   (func (local (ref null extern) (ref extern)))
# RUN: echo -e -n "\x00asm\x01\x00\x00\x00\x01\x04\x01\x60\x00\x00\x02\x1a\x03\x01e\x01t\x01\x63\x70\x00\x00\x01e\x01g\x03\x63\x6f\x00\x01e\x01h\x03\x64\x6f\x00\x03\x02\x01\x00\x04\x05\x01\x63\x6f\x00\x00\x06\x07\x01\x63\x6f\x00\xd0\x6f\x0b\x09\x05\x01\x05\x63\x70\x00\x0a\x0a\x01\x08\x02\x01\x63\x6f\x01\x64\x6f\x0b" > %t2.wasm
# RUN: obj2yaml %t2.wasm | FileCheck %s --check-prefix=NULLABLE

#      NULLABLE:        Field:           t
#      NULLABLE:          ElemType:        FUNCREF
#      NULLABLE:        Field:           g
#      NULLABLE:        GlobalType:      EXTERNREF
#      NULLABLE:        Field:           h
#      NULLABLE:        GlobalType:      OTHERREF
#      NULLABLE:  - Type:            TABLE
#      NULLABLE:          ElemType:        EXTERNREF
#      NULLABLE:  - Type:            GLOBAL
#      NULLABLE:          Type:            EXTERNREF
#      NULLABLE:  - Type:            ELEM
#      NULLABLE:          ElemKind:        FUNCREF
#      NULLABLE:  - Type:            CODE
#      NULLABLE:          Locals:
# NULLABLE-NEXT:            - Type:            EXTERNREF
# NULLABLE-NEXT:              Count:           1
# NULLABLE-NEXT:            - Type:            OTHERREF
# NULLABLE-NEXT:              Count:           1
